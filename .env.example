DATABASE_URL=postgres://campus_user:campus123@localhost:5432/campus_gigs
# On Vercel + Vercel Postgres, you can leave this unset: the app also reads POSTGRES_URL
# (auto-added when you connect storage). For local init against hosted DB, paste the
# pooled URL here temporarily (Storage tab -> .env.local -> POSTGRES_URL value).
# JWT_SECRET=change_me_in_production
JWT_SECRET=change_me_in_production
PORT=3000
# Optional tuning for serverless: PGPOOL_MAX=5 (default), PGSSL=true to force SSL
PGPOOL_MAX=5
